# Copie para .env.local e preencha. Nunca versione valores reais.

# Nome exibido da aplicação (configurável, sem marca definitiva)
NEXT_PUBLIC_APP_NAME="MultiDrop"
# URL pública da aplicação (usada em redirecionamentos e callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (públicos: URL e chave publishable/anon). Valores locais em `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Supabase service role / secret key. SOMENTE servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

# Chaves de criptografia de tokens (AES-256-GCM), versionadas. Formato: "versão:base64(32 bytes)" separados por vírgula.
# Gere com: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEYS=""
# Versão usada para cifrar novos valores
TOKEN_ENCRYPTION_ACTIVE_VERSION="1"

# Mercado Livre (aplicação criada em https://developers.mercadolivre.com.br/devcenter)
ML_CLIENT_ID=""
ML_CLIENT_SECRET=""
# Deve ser idêntica à cadastrada na aplicação do Mercado Livre (HTTPS obrigatório fora de localhost)
ML_REDIRECT_URI="http://localhost:3000/api/integrations/mercado-livre/callback"
# Site do Mercado Livre
ML_SITE_ID="MLB"
# Habilita PKCE (ativar também no DevCenter, onde passa a ser obrigatório)
ML_USE_PKCE="true"

# SOMENTE testes/desenvolvimento: apontam para o servidor simulado. Recusadas em produção.
# ML_API_BASE_URL="http://localhost:4010"
# ML_AUTH_BASE_URL="http://localhost:4010"

# Segredo para chamadas do agendador (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=""

# Provedor de cobrança: "none" (padrão) ou "development" (somente fora de produção; NÃO financeiro)
BILLING_PROVIDER="none"
